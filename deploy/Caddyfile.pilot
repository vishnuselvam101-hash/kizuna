# KIZUNA pilot front: static web UI + /api and /healthz to the API. Local only (@WEB_BIND@); published on the
# tailnet by `tailscale serve --https=@TS_PORT@`. A public domain later puts the host Caddy in front of this
# (snippet printed by deploy/install-pilot.sh). Generated by deploy/install-pilot.sh.
{
	admin off
	auto_https off
}

http://@WEB_BIND@ {
	bind @WEB_HOST@
	encode zstd gzip
	request_body {
		max_size 26MB
	}
	handle /api/* {
		reverse_proxy @API_BIND@ {
			# keep the X-Forwarded-For set by tailscaled / the host Caddy (both connect from loopback)
			trusted_proxies 127.0.0.1/32 ::1/128
		}
	}
	handle /healthz {
		reverse_proxy @API_BIND@ {
			# keep the X-Forwarded-For set by tailscaled / the host Caddy (both connect from loopback)
			trusted_proxies 127.0.0.1/32 ::1/128
		}
	}
	handle {
		root * /opt/kizuna/web
		try_files {path} /index.html
		file_server
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Strict-Transport-Security "max-age=63072000"
			Cross-Origin-Opener-Policy same-origin
		}
	}
	header -Server
	log {
		output stderr
		format console
	}
}
