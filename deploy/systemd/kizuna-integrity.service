[Unit]
Description=KIZUNA integrity sweep (audit chains + stored object hashes, read-only)
After=postgresql.service
OnFailure=kizuna-alert@%n.service

[Service]
Type=oneshot
User=kizuna
Group=kizuna
EnvironmentFile=/etc/kizuna/admin.env
ExecStart=/opt/kizuna/scripts/integrity-sweep.sh /var/lib/kizuna/objects
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/kizuna
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
MemoryMax=512M
Nice=10
