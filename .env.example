# Copy to .env.local (gitignored) or export. Never commit real values.
KIZUNA_DATABASE_URL=postgres://kizuna_app:CHANGE_ME@127.0.0.1:5432/kizuna_dev
KIZUNA_OWNER_DATABASE_URL=postgres://kizuna:CHANGE_ME@127.0.0.1:5432/kizuna_dev
KIZUNA_TEST_DATABASE_URL=postgres://kizuna_app:CHANGE_ME@127.0.0.1:5432/kizuna_test
KIZUNA_TEST_OWNER_DATABASE_URL=postgres://kizuna:CHANGE_ME@127.0.0.1:5432/kizuna_test
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts TOTP seeds at rest.
KIZUNA_DATA_KEY=
# Key rotation: id of KIZUNA_DATA_KEY (default 1) and old keys still to be read, as id:base64,id:base64
KIZUNA_DATA_KEY_ID=1
KIZUNA_DATA_KEYS_PREVIOUS=
# WebAuthn relying party (origin must be the exact browser origin, rp id its registrable domain)
KIZUNA_WEBAUTHN_RP_ID=localhost
KIZUNA_WEBAUTHN_ORIGIN=http://localhost:8080
KIZUNA_BIND=127.0.0.1:8080
KIZUNA_ACCESS_TTL_SECS=900
KIZUNA_SESSION_TTL_SECS=43200
KIZUNA_MAX_BODY_BYTES=65536
KIZUNA_MAX_UPLOAD_BYTES=26214400
KIZUNA_TRUSTED_PROXY_HOPS=0
KIZUNA_STORAGE_DIR=./var/objects
KIZUNA_LOG=info
# Optional: base64 32-byte Ed25519 seed for signed audit checkpoints. Store outside the database host if possible.
KIZUNA_AUDIT_SIGNING_KEY=
KIZUNA_EXTRACTION_SANDBOX=bwrap
